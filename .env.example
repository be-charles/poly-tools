# Polymarket RTDS Logger Configuration
# Copy this file to .env and customize with your settings

# === Price-to-Beat Settings ===
# Set initial prices manually for each crypto symbol
# These are used when the script starts after a 15-minute window has begun
# Leave blank to auto-detect from first crypto price update

BTC_PRICE_TO_BEAT=
ETH_PRICE_TO_BEAT=
XRP_PRICE_TO_BEAT=
SOL_PRICE_TO_BEAT=

# Example:
# BTC_PRICE_TO_BEAT=95000.00
# ETH_PRICE_TO_BEAT=3500.00
# XRP_PRICE_TO_BEAT=0.65
# SOL_PRICE_TO_BEAT=195.00

# === General Settings ===
# CSV file name for logging data
CSV_FILENAME=polymarket_crypto_15m_log.csv

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === WebSocket Settings ===
# Polymarket RTDS WebSocket endpoint
WS_ENDPOINT=wss://ws-live-data.polymarket.com

# Ping interval in seconds (keep connection alive)
PING_INTERVAL=5

# === API Settings ===
# Polymarket Gamma API base URL
GAMMA_API_BASE=https://gamma-api.polymarket.com

# === Market Settings ===
# Comma-separated list of crypto symbols to track
# Supported: btc, eth, xrp, sol
SUPPORTED_SYMBOLS=btc,eth,xrp,sol
